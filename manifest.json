{
  "name": "jiosaavn",
  "displayName": "JioSaavn",
  "version": "1.0.2",
  "description": "Search & download songs from JioSaavn",
  "homepage": "https://github.com/HemanthJabalpuri/spotiflac-jiosaavn-extension",
  "type": ["metadata_provider", "download_provider"],
  "permissions": {
    "network": [
      "www.jiosaavn.com",
      "aac.saavncdn.com"
    ],
    "storage": true,
    "file": true
  },
  "skipMetadataEnrichment": true,
  "qualityOptions": [
    {
      "id": "AAC_320",
      "label": "AAC 320 kbps",
      "description": "Highest quality JioSaavn offers"
    },
    {
      "id": "AAC_160",
      "label": "AAC 160 kbps",
      "description": "Good quality, smaller files"
    },
    {
      "id": "AAC_96",
      "label": "AAC 96 kbps",
      "description": "Data saver"
    },
    {
      "id": "AAC_48",
      "label": "AAC 48 kbps",
      "description": "Low quality"
    },
    {
      "id": "AAC_12",
      "label": "AAC 12 kbps",
      "description": "Preview quality"
    }
  ],
  "capabilities": {
    "homeFeed": true
  },
  "searchBehavior": {
    "enabled": true,
    "placeholder": "Search JioSaavn ...",
    "filters": [
      { "id": "tracks", "label": "Songs", "icon": "music" },
      { "id": "albums", "label": "Albums", "icon": "album" },
      { "id": "playlists", "label": "Playlists", "icon": "playlist" },
      { "id": "artists", "label": "Artists", "icon": "artist" }
    ]
  },
  "urlHandler": {
    "enabled": true,
    "patterns": [ "www.jiosaavn.com" ]
  },
  "settings": [
    {
      "key": "lang",
      "label": "Languages",
      "type": "string",
      "description": "Comma seperated langauges"
    },
    {
      "key": "clear_cache",
      "label": "Clear Cache",
      "type": "button",
      "description": "Remove all cached data",
      "action": "forceCleanup"
    }
  ],
  "minAppVersion": "4.9.5"
}
